# pr-review-autopilot の設定。scratchpad にコピーして autopilot.env として使う。
# 監視スクリプトはすべてこのファイルを source する（値をスクリプトに埋め込まない）。

# --- リポジトリ ---
AP_OWNER="OWNER"                       # GitHub の owner
AP_REPO="REPO"                         # GitHub のリポジトリ名
AP_REPO_DIR="/absolute/path/to/repo"   # gh を実行する作業ツリー

# --- 監視対象 PR ---
# 自分の担当ぶんだけを列挙する。別担当の PR / マージ済みの PR は入れない。
# （入れると「自分では対応できない起床」が発生して空回りする）
AP_PRS="176 178 179 181 182"

# --- approve のカウントから除外する主体 ---
AP_SELF="your-github-login"            # 自分の approve でマージが走ったら事故
AP_BOTS="greptile|github-actions|devin|linear-code|coderabbit"

# --- タスクキュー（ToRide を使う場合。使わないなら AP_DB を空にする） ---
AP_DB="$HOME/Library/Application Support/toride/toride.db"
AP_REPO_ID="repo8"                     # ToRide 内のリポジトリ ID
AP_PANE_TOTAL=2                        # 同時に走らせるセッション数（ペイン数）

# 「投入できない待ち行列」を除外する SQL 述語。
# 列挙ではなく除外で書く（理由は SKILL.md の「4 回目の失敗」を参照）。
# 空文字にすると will_do 全件を待ち行列として数える。
AP_QUEUE_EXCLUDE="title not like '[Task %' and title not like '[S5]%' and title not like '[S6]%'"

# --- マージ判定 ---
AP_BASE_BRANCH="main"                  # ここを base にしている PR だけマージ候補にする
AP_MIN_APPROVE=1                       # 自分・bot を除いた approve の必要数
